# ==============================================================================
# TTA Health Access Risk — .env.example
# Modèle des variables d'environnement (ne jamais commiter de fichier .env réel)
# Copier ce fichier vers '.env' et renseigner vos valeurs locales.
# ==============================================================================

# --- Base de données PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tta_risk
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_placeholder
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Service de routage (OpenRouteService) ---
# Obtenir une clé gratuite sur https://openrouteservice.org/dev/#/signup
ORS_API_KEY=your_openrouteservice_api_key_here
ORS_BASE_URL=https://api.openrouteservice.org

# --- Services météorologiques (Open-Meteo) ---
# API publique sans clé obligatoire sous conditions d'usage non-commercial
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive

# --- Configuration de l'Application Streamlit ---
DATA_DIR=data/processed
OFFLINE_MODE=false
STREAMLIT_SERVER_PORT=8501

# --- Apache Airflow (Docker / Local) ---
AIRFLOW_UID=50000
